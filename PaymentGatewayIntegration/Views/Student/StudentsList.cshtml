    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<PaymentGatewayIntegration.Models.Student>
@{
    <h2>Students List</h2>

    <a href="/Student/StudentsAdd" class="btn btn-primary">Add Student</a>


    <table class="table table-bordered mt-3">
        <tr>
            <th>Name</th>
            <th>Course</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Course</td>
                <td>@item.Age</td>
                <td>
                    <a href="/Student/StudentsEdit/@item.Id">Edit</a> |
                    <a href="/Student/StudentsDelete/@item.Id">Delete</a> |
                    <a href="/Payment/Pay?studentId=@item.Id&amount=500">Pay Fees</a>
                </td>
            </tr>
        }
    </table>

}
