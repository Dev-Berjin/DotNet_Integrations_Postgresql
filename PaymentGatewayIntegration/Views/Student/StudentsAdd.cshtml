@model PaymentGatewayIntegration.Models.Student
@{
    <h2>Add Student</h2>

    <form asp-action="StudentsAdd" method="post">
        <div>
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div>
            <label>Course</label>
            <input asp-for="Course" class="form-control" />
        </div>

        <div>
            <label>Age</label>
            <input asp-for="Age" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success mt-2">Save</button>
    </form>
}
